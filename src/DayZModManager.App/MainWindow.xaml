<Window x:Class="DayZModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayZModManager.App.ViewModels"
        xmlns:beh="clr-namespace:DayZModManager.App.Behaviors"
        Title="DayZ Local Server Mod Manager"
        Icon="Resources/app.ico"
        Height="700" Width="1020"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="ModItemTemplate" DataType="{x:Type vm:ModItemViewModel}">
            <TextBlock Text="{Binding Name}" Padding="2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBlock Text="{Binding Message}" FontFamily="Consolas" FontSize="12" Foreground="LightGray">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="LightGray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter Property="Foreground" Value="#FF6BC46B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Foreground" Value="#FFE0A23C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Foreground" Value="#FFE06464" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="ModActionButton" TargetType="Button">
            <Setter Property="Width" Value="86" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type vm:SearchResultViewModel}">
            <TextBlock Text="{Binding Name}" Padding="2" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF2D4A6B" Padding="12,10">
            <TextBlock Text="DayZ Local Server Mod Manager" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

		<!-- Footer: status + actions -->
		<Border DockPanel.Dock="Bottom" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0" Padding="12,10">
			<DockPanel>
				<TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontWeight="Bold"
						   Foreground="{Binding IsDirty, Converter={x:Static vm:BoolToBrushConverter.Instance}}"
						   VerticalAlignment="Center" />
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
					<Button Content="Apply" Command="{Binding ApplyCommand}" Width="90" Height="28" Margin="0,0,8,0" />
					<Button Content="Start Server" Command="{Binding StartServerCommand}" Width="110" Height="30"
							Background="#FF2E7D32" Foreground="White" FontWeight="Bold" />
				</StackPanel>
			</DockPanel>
		</Border>

        <!-- Footer: log -->
        <Border DockPanel.Dock="Bottom" Height="160" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
            <ListBox ItemsSource="{Binding Log.Entries}"
                     ItemTemplate="{StaticResource LogEntryTemplate}"
                     Background="#FF1E1E1E"
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch" />
        </Border>

        <!-- Tabs -->
        <TabControl SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Mod Manage" DataContext="{Binding Mods}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar: unified search + toggle -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleSelectedCommand}" Width="70" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Two ordering lists -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LoadedCountText}" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="LoadedListBox" ItemsSource="{Binding LoadedItems}" SelectionMode="Extended"
                                     beh:ListBoxSelection.SelectedItems="{Binding SelectedLoadedItems}"
                                     beh:MouseDoubleClickBehavior.Command="{Binding UnloadSelectedCommand}"
                                     beh:ListBoxDragDropReorder.ReorderCommand="{Binding ReorderCommand}"
                                     ItemTemplate="{StaticResource ModItemTemplate}" />
                        </DockPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="Move Up" Style="{StaticResource ModActionButton}" Command="{Binding MoveUpCommand}" Margin="0,0,0,6" />
                            <Button Content="Move Down" Style="{StaticResource ModActionButton}" Command="{Binding MoveDownCommand}" Margin="0,0,0,16" />
                            <Button Content="Load" Style="{StaticResource ModActionButton}" Command="{Binding LoadSelectedCommand}" Margin="0,0,0,6" />
                            <Button Content="Unload" Style="{StaticResource ModActionButton}" Command="{Binding UnloadSelectedCommand}" />
                            <Button Content="Select All" Style="{StaticResource ModActionButton}" Click="SelectAll_Click" Focusable="False"
                                    IsEnabled="{Binding CanSelectAll}" Margin="0,16,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding AvailableCountText}" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="AvailableListBox" ItemsSource="{Binding AvailableItems}" SelectionMode="Extended"
                                     beh:ListBoxSelection.SelectedItems="{Binding SelectedAvailableItems}"
                                     beh:MouseDoubleClickBehavior.Command="{Binding LoadSelectedCommand}"
                                     ItemTemplate="{StaticResource ModItemTemplate}" />
                        </DockPanel>
                    </Grid>

                    <!-- Floating search results dropdown (overlays the lists) -->
                    <ListBox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Panel.ZIndex="100" MinWidth="320" MaxHeight="240"
                             Background="White" BorderBrush="#FFBBBBBB" BorderThickness="1"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult}"
                             SelectionMode="Single"
                             beh:MouseDoubleClickBehavior.Command="{Binding ToggleSelectedCommand}"
                             ItemTemplate="{StaticResource SearchResultTemplate}"
                             Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />

                    <!-- Bottom buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh Mods" Command="{Binding RefreshCommand}" Width="110" />
                        <Button Content="Remove Missing" Command="{Binding RemoveMissingCommand}" Width="110" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="MapTypesTab" Header="Map &amp; Types" DataContext="{Binding MapTypes}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Current Map:" VerticalAlignment="Center" Margin="0,0,8,0" Width="90" />
                        <ComboBox ItemsSource="{Binding MapNames}" SelectedItem="{Binding SelectedMap}" Width="280" />
                        <Button Content="Apply Map" Command="{Binding ApplyMapCommand}" IsEnabled="{Binding CanApplyMap}" Width="90" Margin="8,0,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Types Config:" VerticalAlignment="Center" Margin="0,0,8,0" Width="90" />
                        <ComboBox ItemsSource="{Binding ModNames}" SelectedItem="{Binding SelectedMod}" Width="280" />
                        <Button Content="Config XML" Command="{Binding ConfigXmlCommand}" Width="90" Margin="8,0,0,0" />
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding TypesRows}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              CanUserSortColumns="False"
                              SelectionMode="Extended" HeadersVisibility="Column"
                              HorizontalGridLinesBrush="#FFECECEC" VerticalGridLinesBrush="#FFECECEC"
                              beh:DataGridSelection.SelectedItems="{Binding SelectedTypesRows}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                                <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                        <Setter Property="Foreground" Value="Gray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mod Name" Binding="{Binding ModName}" Width="*" />
                            <DataGridTextColumn Header="Types Files" Binding="{Binding FileName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}" Width="120" />
                        <Button Content="Clean Invalid" Command="{Binding CleanInvalidCommand}" Width="120" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,4,0,0" Foreground="Gray" FontSize="11"
                               Text="Note: 3rd-party map mission folders must be manually placed in mpmissions. Gray rows indicate mods that are not loaded or no longer present in the workshop." />
                </Grid>
            </TabItem>

            <TabItem Header="Settings" DataContext="{Binding Settings}">
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Workshop path:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorkshopPath}" VerticalAlignment="Center" Margin="0,0,8,8" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseWorkshopCommand}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server path:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServerPath}" VerticalAlignment="Center" Margin="0,0,8,8" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseServerCommand}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Batch file:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BatFileName}" VerticalAlignment="Center" Margin="0,0,8,8" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Command="{Binding BrowseBatchFileCommand}" Margin="0,0,0,8" />
                    </Grid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
