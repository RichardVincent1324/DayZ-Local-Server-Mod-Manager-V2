<Window x:Class="DayZModManager.App.Dialogs.AddPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate Preset" Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" VerticalContentAlignment="Center" Padding="4" MaxLength="30" />
		
        <StackPanel x:Name="DestinationMapPanel" Visibility="Collapsed" Margin="0,12,0,0" Orientation="Horizontal">
            <TextBlock Text="Target Map:" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="DestinationMapBox" 
                      Width="280"
                      VerticalContentAlignment="Center" 
                      Padding="4" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConfirmButton" Content="Duplicate" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Create_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>