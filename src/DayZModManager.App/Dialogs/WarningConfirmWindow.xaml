<Window x:Class="DayZModManager.App.Dialogs.WarningConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Yes" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Yes_Click" />
            <Button Content="No" Width="80" IsCancel="True" Click="No_Click" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
            <StackPanel>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" />

                <Border x:Name="WarningPanel" Margin="0,12,0,0" Padding="10,8"
                        Background="#FFFFEBEE" BorderBrush="#FFF2C6CC" BorderThickness="1" CornerRadius="3">
                    <TextBlock x:Name="WarningText" Foreground="#FFB00020" FontWeight="Bold" TextWrapping="Wrap" />
                </Border>

                <TextBlock x:Name="NoteText" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
