<Window x:Class="DayZModManager.App.Dialogs.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name" Height="170" Width="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" VerticalContentAlignment="Center" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
