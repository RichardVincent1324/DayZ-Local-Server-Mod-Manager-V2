<Window x:Class="DayZModManager.App.Dialogs.TypeFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Types Files" Height="460" Width="660"
        MinHeight="280" MinWidth="440"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="{Binding ModName, StringFormat=XML files found for {0} - check the ones to include:}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Margin="0,0,0,6" Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap"
                       Text="Files whose name contains &quot;type&quot; or &quot;spawnable&quot; are classified automatically. For any other file, choose whether it is a Types or Spawnable Types file; the choice is recorded in the types configuration." />
            <Grid>
                <Button Content="Open mod folder" Width="130" HorizontalAlignment="Left"
                        IsEnabled="{Binding HasUnrecognizedOptions}" Click="OpenModFolder_Click"
                        ToolTip="Open this mod's Workshop folder so you can inspect the unrecognized XML files." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="OK" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
                    <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecognizedOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayPath}" IsChecked="{Binding IsChecked}" Margin="4,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasUnrecognizedOptions, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="#FFD0D0D0" Margin="4,6" />
                        <TextBlock Text="Unrecognized files (choose a role below)"
                                   Foreground="Gray" FontSize="11" Margin="4,0,4,4" />
                        <ItemsControl ItemsSource="{Binding UnrecognizedOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="{Binding DisplayPath}"
                                                  IsChecked="{Binding IsChecked}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Width="100" Margin="8,0,0,0"
                                                  ItemsSource="{Binding RoleChoices}"
                                                  DisplayMemberPath="Display"
                                                  SelectedValuePath="Role"
                                                  SelectedValue="{Binding Role, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsChecked}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
