<Window x:Class="DayZModManager.App.Dialogs.TypeFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Types Files" Height="420" Width="620"
        MinHeight="260" MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="{Binding ModName, StringFormat=Types files found for {0} - check the ones to include:}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Margin="0,0,0,6" Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap"
                       Text="Select at most two files per mod (one types file and one spawnabletypes file). Files that are already configured for this mod are pre-selected; choosing another file of the same type replaces the previous one." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
                <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayPath}" IsChecked="{Binding IsChecked}" Margin="4,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
