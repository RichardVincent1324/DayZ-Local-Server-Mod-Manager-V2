<Window x:Class="DayZModManager.App.Dialogs.TypeFilePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Types Files" Height="460" Width="660"
        MinHeight="280" MinWidth="440"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8"
                   Text="{Binding ModName, StringFormat=XML files found for {0} - check the ones to import:}" />
        <!-- Import destination: the Mod Manage tab has no visible Map/Preset
             selectors, so this is where the user confirms where the files go. -->
        <TextBlock DockPanel.Dock="Top" Margin="0,-4,0,8" Foreground="Gray" FontSize="11"
                   Text="{Binding TargetDescription, StringFormat=Copying into preset: {0}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TargetDescription}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
            <TextBlock Margin="0,0,0,6" Foreground="Gray" FontSize="11"
                       TextWrapping="Wrap"
                       Text="Selected files are copied into the active preset's type_files folder. They start unassigned; choose each file's type in the table afterward." />
            <Grid>
                <Button Content="Open mod folder" Width="130" HorizontalAlignment="Left"
                        Click="OpenModFolder_Click"
                        ToolTip="Open this mod's Workshop folder to inspect its XML files." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Import" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
                    <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
        <Border BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecognizedOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayPath}" IsChecked="{Binding IsChecked}" Margin="4,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="#FFD0D0D0" Margin="4,6"
                            Visibility="{Binding ShowGroupSeparator, Converter={StaticResource BoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding UnrecognizedOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayPath}" IsChecked="{Binding IsChecked}" Margin="4,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
