<Window x:Class="DayZModManager.App.Dialogs.AddPresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Preset" Height="230" Width="440"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" VerticalContentAlignment="Center" Padding="4" />
        <CheckBox x:Name="CopyProfilesBox"
                  Content="Copy profiles data from __default_preset__"
                  IsChecked="True"
                  Margin="0,14,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Create" Width="80" IsDefault="True" Margin="0,0,8,0" Click="Create_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
