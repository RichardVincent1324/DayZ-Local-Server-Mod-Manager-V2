<Window x:Class="DayZModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayZModManager.App.ViewModels"
        xmlns:beh="clr-namespace:DayZModManager.App.Behaviors"
        Title="DayZ Mod Manager v2.0.2"
        Icon="Resources/app.ico"
        Height="700" Width="1020"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="ModItemTemplate" DataType="{x:Type vm:ModItemViewModel}">
            <TextBlock Text="{Binding Name}" Padding="2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="LoadedModItemTemplate" DataType="{x:Type vm:ModItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Drag handle: passive glyph (not a Button) so the whole row keeps
                     initiating the drag. -->
                <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="Segoe MDL2 Assets"
                           FontSize="12" Foreground="#FF9A9A9A" VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <TextBlock Grid.Column="1" Text="{Binding Name}" Padding="2" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="2" Text="{Binding Position, StringFormat=#{0}}"
                           Foreground="#FF9A9A9A" VerticalAlignment="Center" Margin="6,0,2,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type vm:LogEntry}">
            <TextBox Text="{Binding Message}" IsReadOnly="True" IsHitTestVisible="False" Focusable="False"
                     FontFamily="Consolas" FontSize="12"
                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Foreground" Value="LightGray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Success">
                                <Setter Property="Foreground" Value="#FF6BC46B" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning">
                                <Setter Property="Foreground" Value="#FFE0A23C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter Property="Foreground" Value="#FFE06464" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </DataTemplate>

        <Style x:Key="LogListItemStyle" TargetType="ListBoxItem">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF333333" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF2D4A6B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModListItemStyle" TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1F26A0DA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A826A0DA" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#3DDADADA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDADADA" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#3D26A0DA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF26A0DA" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=(beh:ListBoxDragDropReorder.IsDragActive)}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#3DDADADA" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFDADADA" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Loaded-list rows stretch so the load-order number can right-align. -->
        <Style x:Key="LoadedModListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ModListItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ModActionButton" TargetType="Button">
            <Setter Property="Width" Value="86" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Chrome-less icon button (Segoe MDL2 glyph) with a faint hover wash;
             the glyph grays out automatically when the button is disabled. The
             transparent background keeps the full click area hit-testable. -->
        <Style x:Key="FolderIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsEnabled" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chrome" Property="Background" Value="#14000000" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SearchResultTemplate" DataType="{x:Type vm:SearchResultViewModel}">
            <TextBlock Text="{Binding Name}" Padding="2" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF2D4A6B" Padding="12,10">
            <TextBlock Text="DayZ Local Server Mod Manager" Foreground="White" FontSize="18" FontWeight="Bold" />
        </Border>

		<!-- Footer: status + actions -->
		<Border DockPanel.Dock="Bottom" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0" Padding="12,10">
			<DockPanel>
				<TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" FontWeight="Bold"
						   Foreground="{Binding IsDirty, Converter={x:Static vm:BoolToBrushConverter.Instance}}"
						   VerticalAlignment="Center" />
				<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="20,0,0,0">
					<Button Content="Apply" Command="{Binding ApplyCommand}" Width="90" Height="28" Margin="0,0,8,0" />
					<Button Content="Start Server" Command="{Binding StartServerCommand}" Width="110" Height="30"
							Background="#FF2E7D32" Foreground="White" FontWeight="Bold" />
				</StackPanel>
			</DockPanel>
		</Border>

        <!-- Footer: log -->
        <Border DockPanel.Dock="Bottom" Height="130" BorderBrush="#FFDDDDDD" BorderThickness="0,1,0,0">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding Log.Entries}"
                     ItemTemplate="{StaticResource LogEntryTemplate}"
                     ItemContainerStyle="{StaticResource LogListItemStyle}"
                     SelectionMode="Extended"
                     Background="#FF1E1E1E"
                     BorderThickness="0"
                     beh:ListBoxAutoScroll.AutoScroll="True"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     PreviewKeyDown="LogListBox_PreviewKeyDown" />
        </Border>

        <!-- Tabs -->
        <TabControl SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="ModsTab" Header="Mod Manage" DataContext="{Binding Mods}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top bar: unified search + toggle -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{Binding ToggleButtonText}" Command="{Binding ToggleSelectedCommand}" Width="70" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Two ordering lists -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LoadedCountText}" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="LoadedListBox" ItemsSource="{Binding LoadedItems}" SelectionMode="Extended"
                                     ItemContainerStyle="{StaticResource LoadedModListItemStyle}"
                                     beh:ListBoxSelection.SelectedItems="{Binding SelectedLoadedItems}"
                                     beh:MouseDoubleClickBehavior.Command="{Binding UnloadSelectedCommand}"
                                     beh:ListBoxDragDropReorder.ReorderCommand="{Binding ReorderCommand}"
                                     ItemTemplate="{StaticResource LoadedModItemTemplate}" />
                        </DockPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                            <Button Content="Load" Style="{StaticResource ModActionButton}" Command="{Binding LoadSelectedCommand}" Margin="0,0,0,6" />
                            <Button Content="Unload" Style="{StaticResource ModActionButton}" Command="{Binding UnloadSelectedCommand}" />
                            <Button Content="Select All" Style="{StaticResource ModActionButton}" Click="SelectAll_Click" Focusable="False"
                                    IsEnabled="{Binding CanSelectAll}" Margin="0,16,0,0" />
                        </StackPanel>

                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding AvailableCountText}" FontWeight="Bold" Margin="0,0,0,4" />
                            <ListBox x:Name="AvailableListBox" ItemsSource="{Binding AvailableItems}" SelectionMode="Extended"
                                     beh:ListBoxSelection.SelectedItems="{Binding SelectedAvailableItems}"
                                     beh:MouseDoubleClickBehavior.Command="{Binding LoadSelectedCommand}"
                                     ItemTemplate="{StaticResource ModItemTemplate}" />
                        </DockPanel>
                    </Grid>

                    <!-- Floating search results dropdown (overlays the lists) -->
                    <ListBox Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                             Panel.ZIndex="100" MinWidth="320" MaxHeight="240"
                             Background="White" BorderBrush="#FFBBBBBB" BorderThickness="1"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult}"
                             SelectionMode="Single"
                             beh:MouseDoubleClickBehavior.Command="{Binding ToggleSelectedCommand}"
                             ItemTemplate="{StaticResource SearchResultTemplate}"
                             Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}" />

                    <!-- Bottom buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh Mods" Command="{Binding RefreshCommand}" Width="110" />
                        <Button Content="Remove Missing" Command="{Binding RemoveMissingCommand}" Width="110" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="PresetTypesTab" Header="Preset &amp; Types" DataContext="{Binding PresetTypes}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Current Map (left) + Preset (right) -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Current Map:" VerticalAlignment="Center" Margin="0,0,5,0" Width="80" />
                            <ComboBox ItemsSource="{Binding MapNames}" SelectedItem="{Binding SelectedMap}" Width="280"
                                      VerticalAlignment="Center"
									  ScrollViewer.CanContentScroll="False"
									  VirtualizingStackPanel.IsVirtualizing="False"
                                      MaxDropDownHeight="300" />
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding OpenMapProfilesFolderCommand}"
                                    Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="{Binding MapProfilesFolderToolTip}"
                                    ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                      DisplayMemberPath="DisplayName" Width="240"
                                      VerticalAlignment="Center"
									  ScrollViewer.CanContentScroll="False"
									  VirtualizingStackPanel.IsVirtualizing="False"
                                      MaxDropDownHeight="300" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 1: Types Config (left) + Preset operations (right) -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,6" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Types Config:" VerticalAlignment="Center" Margin="0,0,5,0" Width="80" />
                            <Grid Width="280" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ModNames}" SelectedItem="{Binding SelectedMod}"
                                          VerticalAlignment="Center"
										  ScrollViewer.CanContentScroll="False"
										  VirtualizingStackPanel.IsVirtualizing="False"
                                          MaxDropDownHeight="300" />
                                <TextBlock Text="Select the mod to be configured"
                                           IsHitTestVisible="False" Foreground="Gray"
                                           Margin="7,0,26,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsModSelectionEmpty, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding OpenTypeFilesFolderCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="{Binding OpenTypeFilesFolderToolTip}"
                                    ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding AddPresetCommand}" Width="30" Height="26"
                                    ToolTip="Add preset" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding DuplicatePresetCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Duplicate current preset" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding RenamePresetCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Rename preset" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding DeletePresetCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Delete preset" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <!-- Row 2: Types grid | Progress Saves grid -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" Margin="0,0,8,0" ItemsSource="{Binding TypesRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Extended" HeadersVisibility="Column"
                                  HorizontalGridLinesBrush="#FFECECEC" VerticalGridLinesBrush="#FFECECEC"
                                  beh:DataGridSelection.SelectedItems="{Binding SelectedTypesRows}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInactive}" Value="True">
                                            <Setter Property="Foreground" Value="Gray" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUntracked}" Value="True">
                                            <Setter Property="Foreground" Value="#FFD84315" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mod Name" Binding="{Binding ModName}" Width="3.5*" />
                                <DataGridTextColumn Header="Configured File" Binding="{Binding FileName}" Width="6*" />
                                <DataGridTextColumn Header="File Type" Binding="{Binding FileType}" Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding SaveNames}"
                                  SelectedItem="{Binding SelectedSave}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                  HorizontalGridLinesBrush="#FFECECEC" VerticalGridLinesBrush="#FFECECEC">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                                    <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOrphaned}" Value="True">
                                            <Setter Property="Foreground" Value="#FFD84315" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Progress Saves" Binding="{Binding DisplayName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Row 3: Types operations (left) + Save operations (right) -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}" Width="120" Height="22" />
                            <Button Content="Clean Invalid" Command="{Binding CleanInvalidCommand}" Width="120" Height="22" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding LoadSaveCommand}" Width="30" Height="26"
                                    ToolTip="Load save" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding AddSaveCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Add save" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding RenameSaveCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Rename save" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
                                    Command="{Binding DeleteSaveCommand}" Width="30" Height="26" Margin="4,0,0,0"
                                    ToolTip="Delete save" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Button>
                            <Button Style="{StaticResource FolderIconButtonStyle}"
									Command="{Binding WipeWorldCommand}" Width="30" Height="26" Margin="12,0,0,0"
									ToolTip="Wipe current world" ToolTipService.ShowOnDisabled="True">
								<TextBlock Text="&#xE75C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
											VerticalAlignment="Center" HorizontalAlignment="Center" />
							</Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header=" Settings " DataContext="{Binding Settings}">
                <StackPanel Margin="10">
                    <TextBlock Text="Configuration" FontSize="14" FontWeight="Bold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Workshop path:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="{Binding WorkshopPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="example D:\SteamLibrary\steamapps\common\DayZ\!Workshop" Foreground="LightGray" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkshopPath}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse" Command="{Binding BrowseWorkshopCommand}" Width="80" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Server path:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="{Binding ServerPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="example D:\SteamLibrary\steamapps\common\DayZServer" Foreground="LightGray" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServerPath}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse" Command="{Binding BrowseServerCommand}" Width="80" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Batch file:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="{Binding BatFileName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="choose the LocalServer.bat you placed in the server folder" Foreground="LightGray" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatFileName}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Row="2" Grid.Column="2" Content="Choose" Command="{Binding BrowseBatchFileCommand}" Width="80" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Data directory:" VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EffectiveDataDirectory}" VerticalAlignment="Center" Margin="0,0,8,8" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Border Height="1" Background="#FFDDDDDD" Margin="0,14,0,14" />

                    <TextBlock Text="Features" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
                    <CheckBox x:Name="AutoCleanServerLogsCheckBox"
                              Content="Auto-clean server log files on startup"
                              IsChecked="{Binding AutoCleanServerLogs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Click="AutoCleanServerLogs_Click"
                              Loaded="AutoCleanServerLogsCheckBox_Loaded"
                              VerticalContentAlignment="Center">
                        <CheckBox.ToolTip>
                            <ToolTip Style="{StaticResource WrappingToolTipStyle}"
                                     Content="On App Startup: when more than 20 .rpt and .log files have accumulated in the active preset's profiles folder, all of them are deleted. At or below 20 no files are touched. Default: OFF." />
                        </CheckBox.ToolTip>
                    </CheckBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
